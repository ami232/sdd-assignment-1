# Copy this file to .env (which Git ignores) and choose your own passwords.
# SQL Server needs at least 8 characters with three of: upper case,
# lower case, digits, symbols.

# The SQL Server administrator, used only by the db-init job.
MSSQL_SA_PASSWORD=

# The login each service uses for its own database (created by db/init.sql).
TRIPS_DB_PASSWORD=
ROOMS_DB_PASSWORD=
